[user]
	email = stevenyap@futureworkz.com
	name = Steven Yap
[core]
  pager = delta
	excludesfile = /Users/stevenyap/.gitignore_global
  ignorecase = false
	autocrlf = input
[remote "origin"]
  prune = true
  pruneTags = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[credential]
	helper = osxkeychain
[alias]
  ls = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  merge-into = !sh -c '_CURRENT_BRANCH=$(git symbolic-ref --short HEAD) && git checkout $1 && git merge $_CURRENT_BRANCH && git checkout $_CURRENT_BRANCH' -
  close-into = !sh -c '_CURRENT_BRANCH=$(git symbolic-ref --short HEAD) && git checkout $1 && git merge $_CURRENT_BRANCH && git branch -d $_CURRENT_BRANCH' -
  delete-pr = "!sh -c 'git branch -D $1; git push origin --delete $1; true' -"
[commit]
	template = /Users/stevenyap/.stCommitMsg
[pull]
	ff = only
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[init]
	defaultBranch = main
[interactive]
  diffFilter = delta --color-only
[delta]
  side-by-side = false
  navigate = true  # use n and N to move between diff sections
  light = true
  line-numbers = true
  syntax-theme = none
  # modus operandi diff palette, same values the neovim overlay uses
  minus-style = normal "#ffd8d5"
  minus-emph-style = normal "#f3b5af"
  plus-style = normal "#c1f2d1"
  plus-emph-style = normal "#aee5be"
  line-numbers-minus-style = "#aa2222"
  line-numbers-plus-style = "#006700"
  line-numbers-zero-style = "#595959"
  hunk-header-decoration-style = "#595959" box
  file-decoration-style = "#0031a9" ul
[merge]
  conflictstyle = zdiff3
